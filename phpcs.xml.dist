<?xml version="1.0"?>
<ruleset name="TopTexForWooCommerce">
	<description>Coding standards for the TopTex for WooCommerce plugin.</description>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>

	<!-- Scan only our own plugin code. -->
	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<!-- Only allow PHP 7.4+ features. -->
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_supported_wp_version" value="5.8"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>

	<!-- Text domain required everywhere for translations. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="toptex-woocommerce"/>
			</property>
		</properties>
	</rule>

	<!-- WooCommerce-specific capabilities. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
